# Build validation only. Production host/submission policy still requires review.
# Deliberately no publishing, SSH or deployment step.
FROM node:22.23.2-bookworm-slim AS builder
WORKDIR /app
ENV HUSKY=0 npm_config_ignore_scripts=true NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json .npmrc ./
COPY vendor ./vendor
RUN npm ci --ignore-scripts --no-audit --no-fund --strict-ssl=true
COPY . .
ENV IMBUTO_LOCAL_ONLY=true IMBUTO_EXTERNAL_SERVICES=false IMBUTO_ENABLE_SUBMISSIONS=false
ENV NEXT_PUBLIC_IMBUTO_LOCAL_ONLY=true NEXT_PUBLIC_IMBUTO_DEV_SHEETS=false
RUN node node_modules/next/dist/bin/next build --webpack

FROM node:22.23.2-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
